---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import CoverImage from '../content/CoverImage.astro';
import Breadcrumbs from '../content/Breadcrumbs.astro';
import PostMeta from '../content/PostMeta.astro';
import PostLicense from '../content/PostLicense.astro';
import PostLike from '../content/PostLike.astro';
import PostNavigation from '../content/PostNavigation.astro';
import RelatedPosts from '../content/RelatedPosts.astro';
import Comments from '../features/Comments.astro';
import { contentTypes } from '../../config/content';
import { getLocalePath, type Locale } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import { adjacentEntries, getLocalizedEntries, relatedPosts } from '../../lib/content/entries';
import { getSeriesContext, localizedSeriesPath } from '../../lib/content/series';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'posts'>;
}

const { locale, entry } = Astro.props;
const { Content, headings } = await render(entry);
const posts = await getLocalizedEntries('posts', locale);
const seriesContext = await getSeriesContext(entry);
const adjacent = seriesContext || adjacentEntries(posts, entry);
const related = relatedPosts(posts, entry, siteConfig.post.relatedCount);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover}
  locale={locale}
  headings={headings}
  toc={entry.data.toc ?? 'center'}
  article={{ publishedTime: entry.data.pubDate, modifiedTime: entry.data.updatedDate, tags: entry.data.tags }}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: siteConfig.shortName, href: getLocalePath(locale, '/'), icon: 'lucide:home' },
      { label: contentTypes.posts.label[locale], href: getLocalePath(locale, contentTypes.posts.path), icon: contentTypes.posts.icon },
      { label: entry.data.title, icon: 'lucide:file-text' }
    ]}
  />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <CoverImage src={entry.data.cover} alt={entry.data.title} variant="hero" priority class="aspect-video max-h-[60vh] w-full object-cover" />
    </div>
  )}
  <PostMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.pubDate}
    locale={locale}
    categories={entry.data.categories}
    tags={entry.data.tags}
    series={seriesContext ? {
      title: seriesContext.series.entry.data.title,
      href: localizedSeriesPath(seriesContext.series.entry),
      position: seriesContext.position,
      total: seriesContext.series.chapters.length
    } : undefined}
  />
  <article class="prose mb-12 max-w-none">
    <Content />
  </article>
  <PostLicense locale={locale} />
  <PostLike articleId={entry.id} locale={locale} />
  {entry.data.comments && <Comments locale={locale} />}
  <PostNavigation previous={adjacent.previous} next={adjacent.next} locale={locale} kind={seriesContext ? 'series' : 'post'} />
  <RelatedPosts posts={related} locale={locale} />
</BaseLayout>

---
import BaseLayout from '../layout/BaseLayout.astro';
import PageHeader from '../content/PageHeader.astro';
import SeriesList from '../content/SeriesList.astro';
import type { Locale } from '../../config/i18n';
import { getDisplaySeries } from '../../lib/content/series';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const series = await getDisplaySeries(locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('series.title')} description={t('series.description')} locale={locale}>
  <PageHeader title={t('series.title')} description={t('series.description')} locale={locale} />
  <SeriesList series={series} locale={locale} />
</BaseLayout>

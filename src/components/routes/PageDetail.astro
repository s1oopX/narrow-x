---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import PageHeader from '../content/PageHeader.astro';
import type { Locale } from '../../config/i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'pages'>;
}

const { locale, entry } = Astro.props;
const { Content, headings } = await render(entry);
const isTimeline = entry.data.layout === 'timeline';
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} locale={locale} headings={headings} toc={entry.data.toc ?? (headings.length > 0 ? 'side' : false)} comments={entry.data.comments}>
  <PageHeader title={entry.data.title} description={entry.data.description} date={entry.data.pubDate} locale={locale} />
  <article class:list={['prose mb-12 max-w-none', { 'timeline-prose': isTimeline }]}>
    <Content />
  </article>
</BaseLayout>

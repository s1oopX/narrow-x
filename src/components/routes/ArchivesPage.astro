---
import BaseLayout from '../layout/BaseLayout.astro';
import PageHeader from '../content/PageHeader.astro';
import ArchiveTimeline from '../content/ArchiveTimeline.astro';
import ArchiveFilters from '../content/ArchiveFilters.astro';
import type { Locale } from '../../config/i18n';
import { collectArchiveTerms, getDisplayEntries } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getDisplayEntries('posts', locale);
const categories = collectArchiveTerms(posts, 'categories', locale);
const tags = collectArchiveTerms(posts, 'tags', locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('archive.title')} description={t('archive.description')} locale={locale}>
  <PageHeader title={t('archive.title')} description={t('archive.description')} locale={locale} />
  <ArchiveFilters categories={categories} tags={tags} total={posts.length} locale={locale} />
  <ArchiveTimeline posts={posts} locale={locale} />
</BaseLayout>

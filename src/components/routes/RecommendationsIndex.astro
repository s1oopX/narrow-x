---
import BaseLayout from '../layout/BaseLayout.astro';
import EntryList from '../content/EntryList.astro';
import PageHeader from '../content/PageHeader.astro';
import type { Locale } from '../../config/i18n';
import { getDisplayEntries } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const recommendations = await getDisplayEntries('recommendations', locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('recommendations.title')} description={t('recommendations.description')} locale={locale}>
  <PageHeader title={t('recommendations.title')} description={t('recommendations.description')} locale={locale} />
  <EntryList entries={recommendations} collection="recommendations" locale={locale} priorityFirst />
</BaseLayout>

---
import BaseLayout from '../layout/BaseLayout.astro';
import EntryList from '../content/EntryList.astro';
import PageHeader from '../content/PageHeader.astro';
import type { Locale } from '../../config/i18n';
import { getDisplayEntries } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = await getDisplayEntries('projects', locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('projects.title')} description={t('projects.description')} locale={locale}>
  <PageHeader title={t('projects.title')} description={t('projects.description')} locale={locale} />
  <EntryList entries={projects} collection="projects" locale={locale} priorityFirst />
</BaseLayout>

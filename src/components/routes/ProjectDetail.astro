---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layout/BaseLayout.astro';
import CoverImage from '../content/CoverImage.astro';
import PageHeader from '../content/PageHeader.astro';
import PostLike from '../content/PostLike.astro';
import ProjectLinks from '../content/ProjectLinks.astro';
import type { Locale } from '../../config/i18n';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} locale={locale} headings={headings} toc={entry.data.toc ?? 'center'} comments={entry.data.comments}>
  <PageHeader title={entry.data.title} description={entry.data.description} date={entry.data.pubDate} locale={locale} />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <CoverImage src={entry.data.cover} alt={entry.data.title} variant="hero" priority class="aspect-video max-h-[60vh] w-full object-cover" />
    </div>
  )}
  <ProjectLinks links={entry.data.links} />
  <article class="prose max-w-none">
    <Content />
  </article>
  <PostLike articleId={`projects:${entry.id}`} locale={locale} />
</BaseLayout>

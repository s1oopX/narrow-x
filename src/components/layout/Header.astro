---
import { Icon } from 'astro-icon/components';
import { getLocalePath, type Locale } from '../../config/i18n';
import { getPrimaryNavigation, isActiveNavPath } from '../../config/navigation';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import Dock from '../ui/Dock.astro';

interface Props {
  locale: Locale;
  title?: string;
}

const { locale, title = siteConfig.name } = Astro.props;
const t = useTranslations(locale);
const headerTitle = title === siteConfig.name ? t('dock.home') : title;
const homeHref = getLocalePath(locale, '/');
const navigation = getPrimaryNavigation(locale, t);
const currentPath = Astro.url.pathname;
const headerClass = siteConfig.ui.navbar.sticky ? 'sticky top-0' : 'relative';

function isActive(href: string) {
  return isActiveNavPath(href, currentPath, homeHref);
}
---

<header class:list={[headerClass, 'z-30 border-b border-border bg-background/80 backdrop-blur']}>
  <div class="mx-auto flex min-h-16 w-full max-w-[calc(var(--layout-content-width)+19rem)] items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <a href={homeHref} class="min-w-0 truncate font-semibold lg:hidden">{headerTitle}</a>
    <div class="hidden min-w-0 lg:block">
      <p class="truncate text-lg font-semibold">{headerTitle}</p>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      <button type="button" data-search-open class="grid h-9 w-9 place-items-center rounded-[var(--radius-control)] text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground" aria-label={t('nav.search')} title={t('nav.search')}>
        <Icon name="lucide:search" class="h-4 w-4" />
      </button>
      {siteConfig.ui.dock.enabled && (
        <div class="hidden lg:block">
          <Dock locale={locale} variant="header" />
        </div>
      )}
      <span class="mx-1 hidden h-5 w-px bg-border lg:block" aria-hidden="true"></span>
      <button type="button" data-login-open class="grid h-9 w-9 place-items-center rounded-[var(--radius-control)] text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground" aria-label={t('nav.admin')} title={t('nav.admin')}>
        <Icon name="lucide:circle-user-round" class="h-5 w-5" />
      </button>
      <button type="button" data-mobile-menu aria-expanded="false" class="grid h-9 w-9 place-items-center rounded-[var(--radius-control)] transition-colors hover:bg-accent lg:hidden" aria-label={t('nav.menu')}>
        <Icon name="lucide:menu" class="h-4 w-4" />
      </button>
    </div>
  </div>
  <nav data-mobile-panel class="mt-2 hidden rounded-[var(--radius-card)] border border-border bg-popover p-2 shadow-[var(--surface-shadow-strong)] lg:hidden" aria-label={t('a11y.mobileNav')}>
    {navigation.map((item) => (
      <a class:list={['flex items-center gap-2 rounded-[var(--radius-control)] px-3 py-2 text-sm', isActive(item.href) ? 'bg-accent text-accent-foreground ring-1 ring-primary/35' : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground']} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        <Icon name={item.icon} class="h-4 w-4" />
        {item.label}
      </a>
    ))}
  </nav>
</header>

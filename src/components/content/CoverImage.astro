---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assetPath } from '../../lib/asset-path';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  variant: 'card' | 'showcase' | 'hero';
  priority?: boolean;
  class?: string;
}

const { src, alt, variant, priority = false, class: className } = Astro.props;
const local = typeof src !== 'string';
const widths = variant === 'hero' ? [640, 960, 1280, 1600] : [360, 720];
const sizes = variant === 'hero'
  ? '(min-width: 960px) 56rem, calc(100vw - 2rem)'
  : variant === 'showcase'
    ? '(min-width: 1024px) 18rem, (min-width: 640px) 45vw, calc(100vw - 2rem)'
    : '(min-width: 768px) 14rem, calc(100vw - 2rem)';
---

{local ? (
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    quality={78}
    priority={priority}
    decoding="async"
    class={className}
  />
) : (
  <img
    src={assetPath(src)}
    alt={alt}
    width="1600"
    height="900"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class={className}
  />
)}

---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import { assetPath } from '../../lib/asset-path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const avatarSrc = assetPath(siteConfig.author.avatar);
const oauthHref = assetPath('/oauth');
const adminHref = assetPath('/admin/index.html');
---

<dialog
  id="login-modal"
  aria-labelledby="login-title"
  class="m-auto w-[min(32rem,calc(100vw-2rem))] overflow-visible rounded-[var(--radius-card)] border border-border bg-popover p-0 text-popover-foreground shadow-[var(--surface-shadow-strong)] backdrop:bg-black/35 backdrop:backdrop-blur-sm"
>
  <div data-login-panel class="relative px-6 pb-7 pt-12 text-center sm:px-8">
    <img
      src={avatarSrc}
      alt={siteConfig.author.name}
      width="72"
      height="72"
      class="absolute -top-9 left-1/2 h-[4.5rem] w-[4.5rem] -translate-x-1/2 rounded-full border-4 border-popover object-cover shadow-md"
    />
    <form method="dialog" class="absolute right-3 top-3">
      <button
        type="submit"
        class="grid h-8 w-8 place-items-center rounded-full text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
        aria-label={t('login.close')}
        title={t('login.close')}
      >
        <Icon name="lucide:x" class="h-4 w-4" />
      </button>
    </form>

    <h2 id="login-title" class="text-lg font-semibold">
      {t('login.title')} <span>{siteConfig.name}</span>
    </h2>
    <div class="mt-6 flex justify-center">
      <button
        type="button"
        data-login-github
        data-oauth-href={oauthHref}
        data-admin-href={adminHref}
        autofocus
        class="grid h-12 w-12 place-items-center rounded-full border border-border bg-background text-foreground ring-4 ring-primary/10 transition-colors hover:border-primary/40 hover:bg-accent focus-visible:outline-none focus-visible:ring-primary/35"
        aria-label={t('login.github')}
        title={t('login.github')}
      >
        <Icon name="simple-icons:github" class="h-5 w-5" />
      </button>
    </div>
  </div>
</dialog>

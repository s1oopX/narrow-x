---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  position: 'center' | 'panel';
  locale: Locale;
}

const { headings, position, locale } = Astro.props;
const t = useTranslations(locale);
const filtered = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({ ...heading, text: heading.text.replace(/#$/, '').trim() }));
const indent = (depth: number) => `padding-left: ${(depth - 2) * 0.85 + 0.5}rem`;
const panelIndent = (depth: number) => `padding-left: ${(depth - 2) * 0.75 + 0.875}rem`;
---

{filtered.length > 0 && (position === 'center' ? (
  <aside id="toc-center" class="pointer-events-none w-full">
    <div class="pointer-events-auto relative mx-auto -mb-2 w-fit pb-2">
      <button
        id="toc-center-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="toc-center-dropdown"
        class="flex max-w-[min(22rem,calc(100vw-2rem))] items-center gap-2 rounded-full border border-border bg-popover/90 px-4 py-1.5 text-sm text-muted-foreground shadow-lg backdrop-blur transition-colors hover:text-primary"
      >
        <Icon name="lucide:list" class="h-4 w-4 shrink-0" />
        <span id="toc-center-title" class="truncate">{filtered[0]?.text}</span>
        <Icon name="lucide:chevron-down" class="toc-chevron h-4 w-4 shrink-0 transition-transform duration-200" />
      </button>
      <nav
        id="toc-center-dropdown"
        class="toc-dropdown absolute left-1/2 top-full max-h-[60vh] w-[min(20rem,calc(100vw-2rem))] overflow-y-auto rounded-[var(--radius-panel)] border border-border bg-popover p-2 text-left shadow-xl"
      >
        {filtered.map((heading) => (
          <a
            href={`#${heading.slug}`}
            data-toc-link
            class="block truncate rounded-[var(--radius-control)] px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
            style={indent(heading.depth)}
          >
            {heading.text}
          </a>
        ))}
      </nav>
    </div>
  </aside>
) : (
  <aside id="toc-panel" aria-label={t('toc.label')} class="hidden w-60 shrink-0 xl:block">
    <nav data-toc-panel-scroll class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-8">
      <h2 class="mb-4 text-xs font-semibold uppercase text-muted-foreground">{t('toc.label')}</h2>
      <div class="border-l border-border">
        {filtered.map((heading) => (
          <a
            href={`#${heading.slug}`}
            data-toc-link
            class="-ml-px block border-l-2 border-transparent py-1.5 pr-2 text-sm leading-snug text-muted-foreground transition-colors hover:text-foreground"
            style={panelIndent(heading.depth)}
          >
            {heading.text}
          </a>
        ))}
      </div>
    </nav>
  </aside>
))}

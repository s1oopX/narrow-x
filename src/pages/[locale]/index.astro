---
import HomeIndex from '../../components/routes/HomeIndex.astro';
import { nonDefaultLocales, type Locale } from '../../config/i18n';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<HomeIndex locale={locale} />

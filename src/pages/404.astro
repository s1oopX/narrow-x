---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { defaultLocale, getLocalePath } from '../config/i18n';
import { useTranslations } from '../i18n/utils';

// A single 404.html serves every path, so the page is server-rendered in the
// default locale and a small inline script swaps the strings and home link
// when the requested pathname belongs to the non-default `/en/` tree.
const locale = defaultLocale;
const t = useTranslations(locale);
const tEn = useTranslations('en');
const homeHref = getLocalePath(locale, '/');
const enHomeHref = getLocalePath('en', '/');
const base = import.meta.env.BASE_URL || '/';
---

<BaseLayout title="404" description={t('notFound.title')} locale={locale} noindex>
  <section class="py-20" data-notfound data-base={base}>
    <p class="text-sm font-medium text-primary">404</p>
    <h1 class="mt-3 text-4xl font-bold" data-nf-swap data-en={tEn('notFound.title')}>{t('notFound.title')}</h1>
    <p class="mt-4 text-muted-foreground" data-nf-swap data-en={tEn('notFound.description')}>{t('notFound.description')}</p>
    <a
      href={homeHref}
      data-nf-home
      data-en={tEn('notFound.action')}
      data-en-href={enHomeHref}
      class="mt-8 inline-flex rounded-[var(--radius-control)] bg-primary px-4 py-2 text-primary-foreground"
    >{t('notFound.action')}</a>
  </section>
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-notfound]');
      if (!root) return;
      const base = (root.getAttribute('data-base') || '/').replace(/\/?$/, '/');
      let path = window.location.pathname;
      if (path.startsWith(base)) path = `/${path.slice(base.length)}`;
      if (!/^\/en(\/|$)/.test(path)) return;
      document.documentElement.lang = 'en';
      root.querySelectorAll('[data-nf-swap]').forEach((el) => {
        const text = el.getAttribute('data-en');
        if (text) el.textContent = text;
      });
      const home = root.querySelector('[data-nf-home]');
      if (home) {
        const text = home.getAttribute('data-en');
        const href = home.getAttribute('data-en-href');
        if (text) home.textContent = text;
        if (href) home.setAttribute('href', href);
      }
    })();
  </script>
</BaseLayout>

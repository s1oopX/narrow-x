---
import type { CollectionEntry } from 'astro:content';
import RecommendationDetail from '../../components/routes/RecommendationDetail.astro';
import { defaultLocale } from '../../config/i18n';
import { getLocalizedEntries, entrySlug } from '../../lib/content/entries';

export async function getStaticPaths() {
  const recommendations = await getLocalizedEntries('recommendations', defaultLocale);
  return recommendations.map((entry) => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'recommendations'>;
}

const { entry } = Astro.props;
---

<RecommendationDetail locale={defaultLocale} entry={entry} />

{
  "name": "narrow-x",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro sync && tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "oauth": "node server/oauth.mjs",
    "oauth:self-test": "node server/oauth.mjs --self-test",

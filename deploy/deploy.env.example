DEPLOY_WEBHOOK_SECRET=
DEPLOY_PORT=4181
DEPLOY_MAX_BODY_BYTES=1048576
DEPLOY_REPOSITORY=your-github/narrow-x
DEPLOY_SCRIPT=/var/www/narrow-x/scripts/deploy-vps.sh
# Kill a deploy child that runs longer than this (milliseconds).
DEPLOY_TIMEOUT_MS=600000
APP_DIR=/var/www/narrow-x
REPO_DIR=/var/www/narrow-x
RELEASES_DIR=/var/www/narrow-x/releases
CURRENT_LINK=/var/www/narrow-x/current
ASTRO_SITE=https://example.com
DEPLOY_HEALTHCHECK_URL=http://127.0.0.1/healthz
DEPLOY_HEALTHCHECK_HOST=example.com
# Post-switch gate also requires HTTP 200 + an HTML body from the site root.
DEPLOY_SITE_CHECK_URL=http://127.0.0.1/
# Refuse to deploy when the releases filesystem has less free space (MiB).
DEPLOY_MIN_FREE_MB=2048
DEPLOY_ALLOW_MAINTENANCE=0
# Read by scripts/check-production.mjs (not the webhook): a redirect only
# counts as "protected" when its Location host is this host or a subdomain.
# SMOKE_AUTH_HOST=cloudflareaccess.com
